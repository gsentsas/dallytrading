####################################################################
# DALLYTRADING — Variables d'environnement (MODÈLE)
#
# Copier vers .env puis remplir. NE JAMAIS committer .env.
#   cp .env.example .env && chmod 600 .env
#
# Générer les secrets avec :
#   ./infrastructure/scripts/generate-secrets.sh
####################################################################

# ─── Identité du déploiement ──────────────────────────────────────
COMPOSE_PROJECT_NAME=dallytrading
# development | staging | production
ENVIRONMENT=production
TZ=Africa/Dakar

# ─── Versions d'images (FIGÉES — jamais de tag :latest, §5) ───────
ODOO_IMAGE=odoo:19.0
POSTGRES_IMAGE=postgres:16-alpine

# ─── PostgreSQL ───────────────────────────────────────────────────
# Conteneur dédié. AUCUN port publié sur l'hôte (§7, §13).
POSTGRES_DB=dallytrading
POSTGRES_USER=odoo_dally
# Généré par generate-secrets.sh (openssl rand -hex 32).
# Aucun commentaire en fin de ligne : il serait lu comme faisant partie
# de la valeur par les analyseurs de fichiers .env.
POSTGRES_PASSWORD=
POSTGRES_HOST=dallytrading-postgres
POSTGRES_PORT=5432
# Identité explicite des ressources de production. Les scripts de backup/restore
# les vérifient avant toute opération ; ne jamais réutiliser ces noms en recette.
PG_CONTAINER=dallytrading-postgres
POSTGRES_VOLUME=dallytrading_postgres_data
PRIVATE_NETWORK=dallytrading_private

# ─── Odoo ─────────────────────────────────────────────────────────
ODOO_DB_NAME=dallytrading
ODOO_CONTAINER=dallytrading-odoo
ODOO_FILESTORE_VOLUME=dallytrading_odoo_filestore
PUBLIC_NETWORK=dallytrading_public
# Master password Odoo. Le Database Manager est désactivé (list_db=False),
# mais ce mot de passe doit rester fort : openssl rand -hex 32
ODOO_ADMIN_PASSWD=

# Ports publiés sur 127.0.0.1 UNIQUEMENT.
# 18069/18072 sont déjà pris par une autre instance sur ce serveur.
ODOO_HTTP_PORT=18169
ODOO_LONGPOLLING_PORT=18172

# Dimensionnement — calculé pour 12 vCPU / ~17 Gi disponibles sur un
# serveur mutualisé. Pire cas ≈ ODOO_WORKERS × limit_memory_hard.
ODOO_WORKERS=4
ODOO_MAX_CRON_THREADS=2
# 1.5 Gi
ODOO_LIMIT_MEMORY_SOFT=1610612736
# 2.0 Gi
ODOO_LIMIT_MEMORY_HARD=2147483648
ODOO_LIMIT_TIME_CPU=120
ODOO_LIMIT_TIME_REAL=240
ODOO_LOG_LEVEL=info

# Limites Docker (garde-fous indépendants des limites Odoo)
ODOO_MEM_LIMIT=9g
POSTGRES_MEM_LIMIT=4g
POSTGRES_SHM_SIZE=1g

# ─── Site public (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dallytrading.com
WEB_PORT=3010

# ─── Site public : identite et coordonnees ────────────────────────
#
# ⚠️  CES VARIABLES SONT INLINÉES AU BUILD, PAS LUES AU RUNTIME.
#
# Next.js remplace chaque NEXT_PUBLIC_* par sa valeur littérale pendant
# `next build`, et les pages statiques (accueil, à propos, les 11 pages
# activités) sont rendues à ce moment-là. Les définir uniquement dans
# l'environnement d'exécution produit un site SANS téléphone, SANS e-mail
# et SANS bouton WhatsApp sur toutes ces pages — sans aucune erreur.
#
# Constaté en test : bouton WhatsApp absent de l'accueil et des pages
# activités, présent sur /tracking (rendue à la demande). Elles doivent
# donc être présentes AVANT `npm run build`.
#
# Toute coordonnée laissée vide est OMISE de l'interface, jamais remplacée
# par un placeholder : un faux numéro est composé, ne répond pas, et coûte
# le prospect qu'il devait capter.

# production => site indexable + sitemap servi. Toute autre valeur => noindex
# et robots.txt interdisant tout, pour qu'une copie de recette ne concurrence
# jamais la production sur les mêmes mots-clés.
NEXT_PUBLIC_ENVIRONMENT=development

# Affiché tel quel ; le lien tel: en dérive les chiffres.
NEXT_PUBLIC_CONTACT_PHONE=
# Si vide, le numéro de téléphone est réutilisé pour WhatsApp.
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
# Lignes d'adresse séparées par |
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_CITY=Dakar
NEXT_PUBLIC_CONTACT_COUNTRY=Sénégal
# Horaires, lignes séparées par |
NEXT_PUBLIC_CONTACT_HOURS=

NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# true seulement après avoir déposé apps/web/public/brand/dallytrading-emblem.png
# (cf. le README de ce répertoire). Sinon le logo s'affiche en typographie seule,
# ce qui est volontaire : pas d'image cassée en attendant l'asset officiel.
NEXT_PUBLIC_BRAND_EMBLEM=false


# ─── Passerelle Odoo (côté serveur uniquement — JAMAIS exposée au navigateur) ──
# Adapter actif : json2 | dally_api | legacy_rpc
ODOO_GATEWAY_ADAPTER=dally_api
ODOO_URL=https://crm.dallytrading.com
ODOO_DATABASE=dallytrading
# généré depuis Odoo, cf. docs/API.md
ODOO_API_KEY=

# ─── Espace client (portail Odoo) ─────────────────────────────────
#
# Scelle le cookie de session du portail (AES-256-GCM). Serveur uniquement :
# jamais NEXT_PUBLIC_*, jamais committé, jamais journalisé.
#
# Générer :  openssl rand -base64 48
#
# Sans défaut : un défaut de développement finirait par devenir la valeur de
# production, puisque rien ne viendrait jamais le signaler. Le frontend refuse de
# démarrer tant que cette variable est absente ou plus courte que 32 caractères.
#
# La modifier invalide TOUTES les sessions portail ouvertes. C'est le
# comportement voulu : c'est le seul moyen de les révoquer d'un coup.
PORTAL_SESSION_SECRET=

# ─── SMTP (e-mails transactionnels) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dallytrading.com
# starttls | ssl | none
SMTP_ENCRYPTION=starttls

# ─── Sauvegarde distante (S3-compatible) ──────────────────────────
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_DIR=/var/www/vhosts/dallytrading.com/platform/backups
# Chiffrement des archives avant envoi distant : openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Exercice de restauration isolé ──────────────────────────────
# Ressources dédiées, sans port publié et sans montage de production.
RESTORE_COMPOSE_PROJECT_NAME=dallytrading-restore
RESTORE_PG_CONTAINER=dallytrading-restore-postgres
RESTORE_ODOO_CONTAINER=dallytrading-restore-odoo
RESTORE_POSTGRES_VOLUME=dallytrading_restore_postgres_data
RESTORE_FILESTORE_VOLUME=dallytrading_restore_odoo_filestore
RESTORE_NETWORK=dallytrading_restore_private
RESTORE_DB_NAME=dallytrading_restore
RESTORE_DB_USER=postgres

# ─── Alertes monitoring ───────────────────────────────────────────
ALERT_EMAIL=
# % avant alerte
DISK_USAGE_THRESHOLD=85

# Identité UNIX du processus Odoo dans le conteneur.
# Doit correspondre au propriétaire de odoo/config/odoo.conf, qui est en 0600 :
# sans cela Odoo ne peut pas lire sa configuration. Relever avec :
#   stat -c '%u %g' odoo/config/odoo.conf
ODOO_RUN_UID=
ODOO_RUN_GID=
