# ── Secrets — ne JAMAIS versionner (critère §91 : aucun secret dans Git) ──────
.env
.env.*
!.env.example
# Généré depuis odoo.conf.template — contient le mot de passe de la base.
# Aucun commentaire en fin de ligne : .gitignore ne les interprète pas et
# le motif serait pris littéralement, commentaire compris.
odoo/config/odoo.conf
*.pem
*.key
*.crt
secrets/

# ── Sauvegardes et données ────────────────────────────────────────────────────
backups/
*.dump
*.sql
*.sql.gz
*.tar.gz
*.sha256
filestore/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
.pnpm-store/
coverage/
.vercel/

# ── Python / Odoo ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Système / éditeurs ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# ── Plesk / hébergement (hors périmètre du dépôt) ─────────────────────────────
.claude.json
.imunify_patch_id
.myimunify_id

# Instantanés de rollback frontend et artefacts de build de déploiement.
# Ce sont des copies de `.next` — des centaines de mégaoctets, régénérables,
# et propres à une machine. Elles n'ont rien à faire dans l'historique.
rollback/
.deploy-build/
apps/web/.next.old/
apps/web/.next.previous/
# Copie de vérification : `next build` doit s'exécuter ailleurs que dans le
# répertoire servi par systemd, et Turbopack refuse un `node_modules` en lien
# symbolique hors racine projet — d'où une copie sur le même système de fichiers.
.shop-build/
