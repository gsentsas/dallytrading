<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Agrégation de la télémétrie d'usage des clés d'API.

        `noupdate="1"` : l'intervalle et l'état actif sont des réglages
        d'exploitation. Une montée de version du module ne doit pas réactiver un
        cron que quelqu'un a délibérément arrêté, ni écraser une période qu'il a
        ajustée en observant la charge réelle.

        Dix minutes : le compteur n'alimente que deux vues du back-office, et
        personne ne le regarde à la seconde. Plus court multiplierait les
        passages à vide ; plus long laisserait grossir la table sans bénéfice.

        `priority` élevé (bas dans l'ordre d'exécution) : rien ne dépend de ce
        cron, il doit céder le pas à tout ce qui touche au métier.
    -->
    <record id="cron_dally_api_key_usage_aggregate" model="ir.cron">
        <field name="name">DallyTrading — agréger la télémétrie des clés d'API</field>
        <field name="model_id" ref="model_dally_api_key_usage"/>
        <field name="state">code</field>
        <field name="code">model._dally_aggregate()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="priority">50</field>
    </record>
</odoo>
