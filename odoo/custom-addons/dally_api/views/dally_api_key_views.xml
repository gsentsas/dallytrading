<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dally_api_key_view_list" model="ir.ui.view">
        <field name="name">dally.api.key.list</field>
        <field name="model">dally.api.key</field>
        <field name="arch" type="xml">
            <list string="API Keys" create="1">
                <field name="name"/>
                <field name="key_prefix"/>
                <field name="user_id"/>
                <field name="scopes"/>
                <field name="allowed_ips"/>
                <field name="expires_on"/>
                <field name="last_used_at"/>
                <field name="request_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="dally_api_key_view_form" model="ir.ui.view">
        <field name="name">dally.api.key.form</field>
        <field name="model">dally.api.key</field>
        <field name="arch" type="xml">
            <form string="API Key">
                <header>
                    <button name="action_generate_key" type="object"
                            string="Regenerate Key"
                            class="btn-secondary"
                            confirm="Regenerating invalidates the current key immediately.
                                     Any consumer still using it will start receiving 401
                                     responses. Continue?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Revoked" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Next.js production"/></h1>
                    </div>

                    <!-- Shown once, right after generation. -->
                    <div class="alert alert-success" role="alert"
                         invisible="not key_to_display">
                        <h4 class="alert-heading">Copy this key now</h4>
                        <p>
                            It is displayed only this once. It cannot be recovered
                            afterwards — only regenerated, which invalidates this one.
                        </p>
                        <field name="key_to_display" readonly="1" class="fw-bold"/>
                        <p class="mb-0">
                            Store it in the <code>ODOO_API_KEY</code> variable of the
                            website's <code>.env</code> file. Never commit it, and never
                            expose it to the browser.
                        </p>
                    </div>

                    <group>
                        <group string="Identification">
                            <field name="key_prefix" readonly="1"/>
                            <field name="user_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="active"/>
                        </group>
                        <group string="Restrictions">
                            <field name="scopes" placeholder="leads:write,tracking:read"/>
                            <field name="allowed_ips" placeholder="127.0.0.1"/>
                            <field name="expires_on"/>
                        </group>
                    </group>

                    <group string="Usage">
                        <group>
                            <field name="last_used_at" readonly="1"/>
                            <field name="request_count" readonly="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert">
                        <strong>Available scopes:</strong>
                        <code>leads:write</code>, <code>quotes:write</code>,
                        <code>sourcing:write</code>, <code>trading:write</code>,
                        <code>shipments:read</code>, <code>tracking:read</code>,
                        <code>customers:read</code>.
                        Grant only what the consumer actually calls: a key restricted to
                        <code>leads:write</code> is useless to an attacker who wants to
                        read customer data.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dally_api_key_action" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">dally.api.key</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an API key</p>
            <p>
                One key per consumer, so a leak can be revoked without taking every
                integration down. The key is shown once, at creation.
            </p>
        </field>
    </record>

</odoo>
