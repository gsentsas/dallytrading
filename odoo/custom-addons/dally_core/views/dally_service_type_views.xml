<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Odoo 17+ view type: <list>, not the legacy <tree>. -->
    <record id="dally_service_type_view_list" model="ir.ui.view">
        <field name="name">dally.service.type.list</field>
        <field name="model">dally.service.type</field>
        <field name="arch" type="xml">
            <list string="Service Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="published"/>
                <field name="requires_route" optional="hide"/>
                <field name="requires_cargo" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="dally_service_type_view_form" model="ir.ui.view">
        <field name="name">dally.service.type.form</field>
        <field name="model">dally.service.type</field>
        <field name="arch" type="xml">
            <form string="Service Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sea Freight"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code" placeholder="e.g. freight_sea"/>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Public Website">
                            <field name="published"/>
                            <field name="requires_route"/>
                            <field name="requires_cargo"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="Shown to customers on the website."/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        The <strong>code</strong> is referenced by the public website and
                        the API. Changing it on a published service breaks incoming
                        requests that still use the previous value.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dally_service_type_view_search" model="ir.ui.view">
        <field name="name">dally.service.type.search</field>
        <field name="model">dally.service.type</field>
        <field name="arch" type="xml">
            <search string="Service Types">
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_published" string="Published"
                        domain="[('published', '=', True)]"/>
                <filter name="filter_unpublished" string="Not Published"
                        domain="[('published', '=', False)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_category" string="Category"
                            context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dally_service_type_action" model="ir.actions.act_window">
        <field name="name">Service Types</field>
        <field name="res_model">dally.service.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="dally_service_type_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a service type</p>
            <p>
                Service types describe what DallyTrading offers. The public quote
                form and the API refer to them by code.
            </p>
        </field>
    </record>

</odoo>
