<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Multi-company isolation, as on shipments. Per-user ownership rules are
            not implemented and that is a decision: requests are triaged by
            whoever is available, and hiding colleagues' requests would be worked
            around by sharing an account.
        -->
        <record id="dally_quote_request_rule_company" model="ir.rule">
            <field name="name">Quote request: own company only</field>
            <field name="model_id" ref="model_dally_quote_request"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
