<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Technical rights envelopes. They live under the hidden technical
             privilege and are not human business roles. -->
        <record id="group_dally_freight_sync_api" model="res.groups">
            <field name="name">Freight Sync API</field>
            <field name="privilege_id" ref="dally_core.privilege_dallytrading_technical"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Trusted spreadsheet connector: customers, freight files and cargo only.</field>
        </record>

        <record id="group_dally_freight_billing_api" model="res.groups">
            <field name="name">Freight Billing API</field>
            <field name="privilege_id" ref="dally_core.privilege_dallytrading_technical"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')),
                                              (4, ref('sales_team.group_sale_salesman')),
                                              (4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Trusted freight billing connector: native sales, draft invoices, customer payments and internal cash operations.</field>
        </record>
    </data>

    <record id="rule_dally_cash_expense_company" model="ir.rule">
        <field name="name">Dally cash expenses — allowed companies</field>
        <field name="model_id" ref="model_dally_cash_expense"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_dally_cash_expense_allocation_company" model="ir.rule">
        <field name="name">Dally cash expense allocations — allowed companies</field>
        <field name="model_id" ref="model_dally_cash_expense_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_dally_cash_transfer_company" model="ir.rule">
        <field name="name">Dally cash transfers — allowed companies</field>
        <field name="model_id" ref="model_dally_cash_transfer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
