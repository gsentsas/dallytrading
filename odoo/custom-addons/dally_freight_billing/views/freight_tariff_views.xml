<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dally_freight_tariff_family_view_list" model="ir.ui.view">
        <field name="name">dally.freight.tariff.family.list</field>
        <field name="model">dally.freight.tariff.family</field>
        <field name="arch" type="xml">
            <list string="Freight Tariff Families" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dally_freight_tariff_family_view_form" model="ir.ui.view">
        <field name="name">dally.freight.tariff.family.form</field>
        <field name="model">dally.freight.tariff.family</field>
        <field name="arch" type="xml">
            <form string="Freight Tariff Family">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dally_freight_tariff_family_action" model="ir.actions.act_window">
        <field name="name">Freight Tariff Families</field>
        <field name="res_model">dally.freight.tariff.family</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="dally_freight_tariff_rule_view_list" model="ir.ui.view">
        <field name="name">dally.freight.tariff.rule.list</field>
        <field name="model">dally.freight.tariff.rule</field>
        <field name="arch" type="xml">
            <list string="Freight Tariffs"
                  decoration-muted="not active">
                <field name="name"/>
                <field name="transport_mode"/>
                <field name="family_id"/>
                <field name="customer_segment"/>
                <field name="price_per_kg_eur"/>
                <field name="volumetric_ratio_kg_cbm" optional="show"/>
                <field name="date_from" optional="show"/>
                <field name="date_to" optional="show"/>
                <field name="active" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="dally_freight_tariff_rule_view_form" model="ir.ui.view">
        <field name="name">dally.freight.tariff.rule.form</field>
        <field name="model">dally.freight.tariff.rule</field>
        <field name="arch" type="xml">
            <form string="Freight Tariff">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="transport_mode"/>
                            <field name="family_id"/>
                            <field name="customer_segment"/>
                            <field name="active"/>
                        </group>
                        <group string="Price">
                            <field name="price_per_kg_eur"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="volumetric_ratio_kg_cbm"/>
                        </group>
                    </group>
                    <group string="Validity">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dally_freight_tariff_rule_view_search" model="ir.ui.view">
        <field name="name">dally.freight.tariff.rule.search</field>
        <field name="model">dally.freight.tariff.rule</field>
        <field name="arch" type="xml">
            <search string="Freight Tariffs">
                <field name="name"/>
                <field name="family_id"/>
                <filter name="air" string="Air" domain="[('transport_mode', '=', 'air')]"/>
                <filter name="sea" string="Sea" domain="[('transport_mode', '=', 'sea')]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_mode" string="Mode" context="{'group_by': 'transport_mode'}"/>
                    <filter name="group_family" string="Family" context="{'group_by': 'family_id'}"/>
                    <filter name="group_segment" string="Customer Segment" context="{'group_by': 'customer_segment'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dally_freight_tariff_rule_action" model="ir.actions.act_window">
        <field name="name">Freight Tariffs</field>
        <field name="res_model">dally.freight.tariff.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dally_freight_tariff_rule"
              name="Freight Tariffs"
              parent="dally_core.menu_dally_configuration"
              action="dally_freight_tariff_rule_action"
              sequence="30"
              groups="dally_core.group_dally_manager"/>

    <menuitem id="menu_dally_freight_tariff_family"
              name="Freight Tariff Families"
              parent="dally_core.menu_dally_configuration"
              action="dally_freight_tariff_family_action"
              sequence="31"
              groups="dally_core.group_dally_manager"/>
</odoo>
