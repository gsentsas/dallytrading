<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="stage_request_received" model="freight.shipment.stages">
        <field name="name">Demande reçue</field><field name="sequence">10</field>
    </record>
    <record id="stage_awaiting_goods" model="freight.shipment.stages">
        <field name="name">En attente de marchandise</field><field name="sequence">20</field>
    </record>
    <record id="stage_goods_received" model="freight.shipment.stages">
        <field name="name">Marchandise reçue</field><field name="sequence">30</field>
    </record>
    <record id="stage_preparing" model="freight.shipment.stages">
        <field name="name">En préparation</field><field name="sequence">40</field>
    </record>
    <record id="stage_ready" model="freight.shipment.stages">
        <field name="name">Prête à partir</field><field name="sequence">50</field>
    </record>
    <record id="stage_departed" model="freight.shipment.stages">
        <field name="name">Départ effectué</field><field name="sequence">60</field>
    </record>
    <record id="stage_in_transit" model="freight.shipment.stages">
        <field name="name">En transit</field><field name="sequence">70</field>
    </record>
    <record id="stage_arrived" model="freight.shipment.stages">
        <field name="name">Arrivé</field><field name="sequence">80</field>
    </record>
    <record id="stage_customs" model="freight.shipment.stages">
        <field name="name">Dédouanement</field><field name="sequence">90</field>
    </record>
    <record id="stage_available" model="freight.shipment.stages">
        <field name="name">Disponible</field><field name="sequence">100</field>
    </record>
    <record id="stage_out_for_delivery" model="freight.shipment.stages">
        <field name="name">En livraison</field><field name="sequence">110</field>
    </record>
    <record id="stage_delivered" model="freight.shipment.stages">
        <field name="name">Livré</field><field name="sequence">120</field>
        <field name="is_last_stage">1</field>
    </record>
    <!-- L'annulation est un état terminal alternatif. tk_freight n'impose
         pas is_last_stage sur plusieurs enregistrements (contrainte unique),
         mais la contrainte s'appuie sur is_last_stage=True : cette étape
         reste à False et la mécanique tk continue de traiter « Livré »
         comme la conclusion nominale. -->
    <record id="stage_cancelled" model="freight.shipment.stages">
        <field name="name">Annulé</field><field name="sequence">900</field>
    </record>
</odoo>
