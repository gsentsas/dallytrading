  <!--
    La regle d'enregistrement du fournisseur sur freight.shipment devient sans
    objet une fois l'ACL retiree — une regle ne filtre que ce qu'une ACL laisse
    passer. Elle est neanmoins durcie ici, en seconde barriere : si un droit
    portail etait retabli par accident, la regle ne doit plus rien laisser
    passer.

    Le domaine est mis a [(0, '=', 1)], qui ne correspond a aucune ligne. Les
    permissions ne peuvent PAS etre toutes mises a zero : le noyau impose
    CHECK (perm_read or perm_write or perm_create or perm_unlink), contrainte
    `ir_rule_no_access_rights`. On conserve donc perm_read a 1 — une regle de
    lecture dont le domaine est vide est plus restrictive qu'une regle absente,
    puisqu'une absence de regle laisserait tout passer.
  -->
  <record id="tk_freight.freight_security_rule_portal" model="ir.rule">
    <field name="domain_force">[(0, '=', 1)]</field>
    <field name="perm_read" eval="1"/>
    <field name="perm_write" eval="0"/>
    <field name="perm_create" eval="0"/>
    <field name="perm_unlink" eval="0"/>
  </record>

</odoo>
