<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shipment_form_consolidation" model="ir.ui.view">
        <field name="name">dally.shipment.form.consolidation</field>
        <field name="model">dally.shipment</field>
        <field name="inherit_id" ref="dally_freight_notifications.dally_shipment_view_form_notification_ops"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_consolidation" type="object" class="oe_stat_button"
                        icon="fa-plane" invisible="not consolidation_id">
                    <field name="consolidation_id" widget="statinfo" string="Consolidation"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_add_to_open_consolidation" type="object"
                        string="Ajouter à la consolidation ouverte" class="btn-secondary"
                        groups="dally_core.group_dally_logistics"
                        invisible="transport_mode != 'air' or state not in ('goods_received','preparing')"/>
                <button name="action_payment_override" type="object"
                        string="Dérogation paiement" class="btn-secondary"
                        groups="dally_core.group_dally_manager"
                        invisible="state != 'ready' or payment_control == 'OK'"/>
            </xpath>
            <xpath expr="//field[@name='carrier_tracking_number']" position="after">
                <field name="consolidation_id" readonly="1"/>
                <field name="consolidation_state" readonly="1"/>
                <field name="ready_for_departure" readonly="1"/>
                <field name="payment_control" readonly="1"/>
            </xpath>
            <xpath expr="//page[@name='commercial']//group" position="inside">
                <group string="Dérogation départ" groups="dally_core.group_dally_manager"
                       invisible="not departure_payment_override_reason">
                    <field name="departure_payment_override_reason"/>
                    <field name="departure_payment_override_user_id"/>
                    <field name="departure_payment_override_on"/>
                    <field name="departure_payment_override_residual"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="client_package_view_list" model="ir.ui.view">
        <field name="name">dally.shipment.package.client.list</field>
        <field name="model">dally.shipment.package</field>
        <field name="arch" type="xml">
            <list string="Colis clients" create="false" delete="false">
                <field name="shipment_id" string="Dossier fret"/>
                <field name="external_reference" string="Référence Dally"/>
                <field name="partner_id"/>
                <field name="package_type"/><field name="description"/>
                <field name="quantity"/><field name="unit_weight_kg"/>
                <field name="total_weight_kg" sum="Poids total"/><field name="total_volume_cbm" sum="Volume"/>
                <field name="transport_mode"/><field name="route_summary"/>
                <field name="shipment_state"/><field name="consolidation_id"/>
                <field name="consolidation_state"/><field name="ready_for_departure" widget="boolean_toggle"/>
                <field name="payment_control"/><field name="goods_received_on" optional="show"/>
            </list>
        </field>
    </record>

    <record id="client_package_view_search" model="ir.ui.view">
        <field name="name">dally.shipment.package.client.search</field>
        <field name="model">dally.shipment.package</field>
        <field name="arch" type="xml">
            <search string="Colis clients">
                <field name="external_reference"/><field name="shipment_id"/><field name="partner_id"/>
                <field name="description"/><field name="consolidation_id"/>
                <filter name="to_consolidate" string="À consolider" domain="[('available_quantity','&gt;',0),('consolidation_id','=',False)]"/>
                <filter name="consolidating" string="Consolidation en cours" domain="[('consolidation_state','in',('collecting','collection_closed','ready'))]"/>
                <filter name="departed" string="Déjà parti" domain="[('consolidation_state','in',('departed','arrived','closed'))]"/>
                <separator/>
                <filter name="air" string="Aérien" domain="[('transport_mode','=','air')]"/>
                <filter name="sea" string="Maritime" domain="[('transport_mode','=','sea')]"/>
                <filter name="dss_cdg" string="Dakar → Paris" domain="[('route_summary','ilike','Dakar'),('route_summary','ilike','Paris')]"/>
                <filter name="cdg_dss" string="Paris → Dakar" domain="[('route_summary','ilike','Paris'),('route_summary','ilike','Dakar')]"/>
                <separator/>
                <filter name="group_client" string="Client" context="{'group_by':'partner_id'}"/>
                <filter name="group_shipment" string="Dossier" context="{'group_by':'shipment_id'}"/>
                <filter name="group_received" string="Date de réception" context="{'group_by':'goods_received_on:month'}"/>
                <filter name="group_consolidation" string="Consolidation" context="{'group_by':'consolidation_id'}"/>
            </search>
        </field>
    </record>

    <record id="client_package_action" model="ir.actions.act_window">
        <field name="name">Colis clients</field><field name="res_model">dally.shipment.package</field>
        <field name="view_mode">list</field><field name="view_id" ref="client_package_view_list"/>
        <field name="search_view_id" ref="client_package_view_search"/>
    </record>
</odoo>
