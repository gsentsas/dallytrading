<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="add_to_consolidation_wizard_view_form" model="ir.ui.view">
        <field name="name">dally.add.to.consolidation.wizard.form</field>
        <field name="model">dally.add.to.consolidation.wizard</field>
        <field name="arch" type="xml">
            <form string="Ajouter à une consolidation">
                <group><field name="shipment_id"/><field name="compatible_consolidation_ids" invisible="1"/>
                    <field name="consolidation_id" options="{'no_create': True}"/></group>
                <div class="alert alert-info" role="alert">
                    Tous les colis encore disponibles du dossier seront ajoutés. Si plusieurs départs sont compatibles, le choix reste obligatoire.
                </div>
                <footer><button name="action_confirm" type="object" string="Ajouter les colis" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
</odoo>
