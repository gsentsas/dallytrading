<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="historical_backfill_wizard_view_form" model="ir.ui.view">
        <field name="name">dally.consolidation.backfill.wizard.form</field>
        <field name="model">dally.consolidation.backfill.wizard</field>
        <field name="arch" type="xml">
            <form string="Dry-run du premier départ">
                <group><field name="consolidation_id" readonly="1"/><field name="cutoff_date"/>
                    <field name="candidate_weight_kg" readonly="1"/><field name="included_weight_kg" readonly="1"/>
                    <field name="mawb_difference_kg" readonly="1"/></group>
                <div class="alert alert-warning" role="alert">
                    La prévisualisation ne modifie aucune donnée. Vérifiez chaque dossier et l'écart avec la MAWB avant confirmation.
                </div>
                <field name="candidate_line_ids">
                    <list editable="bottom" create="false" delete="false"
                          decoration-danger="shipment_state == 'cancelled'" decoration-warning="amount_residual &gt; 0">
                        <field name="include"/><field name="external_reference"/><field name="client_name"/>
                        <field name="goods_received_on"/><field name="shipment_state"/><field name="weight_kg" sum="Poids"/>
                        <field name="package_count" sum="Colis"/><field name="invoice_name"/><field name="invoice_state"/>
                        <field name="payment_state"/><field name="amount_total"/><field name="amount_residual"/>
                        <field name="currency_id" column_invisible="True"/><field name="existing_consolidation"/>
                        <field name="decision_note"/>
                    </list>
                </field>
                <footer><button name="action_preview" type="object" string="Prévisualiser / actualiser" class="btn-secondary"/>
                    <button name="action_confirm" type="object" string="Confirmer le backfill" class="btn-primary"
                            confirm="Confirmer uniquement après validation du tableau. Aucun courriel client ne sera créé."/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
</odoo>
