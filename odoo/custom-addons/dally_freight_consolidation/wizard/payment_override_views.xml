<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_override_wizard_view_form" model="ir.ui.view">
        <field name="name">dally.departure.payment.override.wizard.form</field>
        <field name="model">dally.departure.payment.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Dérogation de paiement">
                <div class="alert alert-warning" role="alert">
                    Cette dérogation est réservée aux clients professionnels. Elle est horodatée et tracée dans le chatter du dossier.
                </div>
                <group><field name="shipment_id"/><field name="reason" placeholder="Motif métier précis et vérifiable…"/></group>
                <footer><button name="action_confirm" type="object" string="Accorder la dérogation" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
</odoo>
