        <record id="airline_hf" model="freight.airline">
            <field name="name">Air Côte d'Ivoire</field>
            <field name="code">HF</field>
            <field name="icao">VRE</field>
            <field name="country" ref="base.ci"/>
        </record>

    </data>
</odoo>
