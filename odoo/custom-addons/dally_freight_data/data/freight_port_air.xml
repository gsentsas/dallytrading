        <record id="airport_ist" model="freight.port">
            <field name="name">Istanbul</field>
            <field name="code">IST</field>
            <field name="country_id" ref="base.tr"/>
            <field name="city">Istanbul</field>
            <field name="ocean" eval="False"/>
            <field name="air" eval="True"/>
            <field name="land" eval="False"/>
