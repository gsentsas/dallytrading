            <field name="visible_in_tracking" eval="True"/>
            <field name="notify_customer" eval="True"/>
        </record>

        <record id="policy_out_for_delivery" model="dally.freight.state.policy">
            <field name="state">out_for_delivery</field>
            <field name="customer_label">En cours de livraison</field>
            <field name="sequence">120</field>
            <field name="visible_in_portal" eval="True"/>
            <field name="visible_in_tracking" eval="True"/>
            <field name="notify_customer" eval="True"/>
        </record>

        <record id="policy_delivered" model="dally.freight.state.policy">
            <field name="state">delivered</field>
            <field name="customer_label">Livrée</field>
            <field name="sequence">130</field>
            <field name="visible_in_portal" eval="True"/>
