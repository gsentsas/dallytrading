            <field name="customer_label">Partie</field>
            <field name="sequence">70</field>
            <field name="visible_in_portal" eval="True"/>
            <field name="visible_in_tracking" eval="True"/>
            <field name="notify_customer" eval="True"/>
        </record>

        <record id="policy_in_transit" model="dally.freight.state.policy">
            <field name="state">in_transit</field>
