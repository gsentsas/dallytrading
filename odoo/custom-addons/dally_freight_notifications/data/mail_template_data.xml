<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_prise_en_charge" model="mail.template">
            <field name="name">Freight — prise en charge / préparation</field>
            <field name="model_id" ref="model_dally_shipment_notification"/>
            <field name="subject">{{ object.shipment_reference }} — {{ object.customer_label }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="lang">{{ object.language_code or 'fr_FR' }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Bonjour,</p>
                    <p>Nous vous informons de l'avancement de votre dossier Freight.</p>
                    <p><strong>Référence :</strong> <t t-out="object.shipment_reference or ''"/></p>
                    <p><strong>Statut :</strong> <t t-out="object.customer_label or ''"/></p>
                    <p t-if="object.origin_label or object.destination_label"><strong>Trajet :</strong> <t t-out="object.origin_label or '—'"/> → <t t-out="object.destination_label or '—'"/></p>
                    <p t-if="object.customer_message"><t t-out="object.customer_message"/></p>
                    <p t-if="object.tracking_url"><a t-att-href="object.tracking_url">Suivre mon expédition</a></p>
                    <p>DallyTrading</p>
                </div>
            </field>
        </record>

