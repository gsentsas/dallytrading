#. module: dally_freight_notifications
#: model:mail.template,body_html:dally_freight_notifications.mail_template_prise_en_charge
msgid ""
"<div>\n"
"                    <p>Bonjour,</p>\n"
"                    <p>Nous vous informons de l'avancement de votre dossier Freight.</p>\n"
"                    <p><strong>Référence :</strong> <t t-out=\"object.shipment_reference or ''\"/></p>\n"
"                    <p><strong>Statut :</strong> <t t-out=\"object.customer_label or ''\"/></p>\n"
"                    <p t-if=\"object.origin_label or object.destination_label\"><strong>Trajet :</strong> <t t-out=\"object.origin_label or '—'\"/> → <t t-out=\"object.destination_label or '—'\"/></p>\n"
"                    <p t-if=\"object.customer_message\"><t t-out=\"object.customer_message\"/></p>\n"
"                    <p t-if=\"object.tracking_url\"><a t-att-href=\"object.tracking_url\">Suivre mon expédition</a></p>\n"
"                    <p>DallyTrading</p>\n"
"                </div>\n"
"            "
msgstr "<div>\n                    <p>Bonjour,</p>\n                    <p>Nous vous informons de l'avancement de votre dossier de fret.</p>\n                    <p><strong>Référence :</strong> <t t-out=\"object.shipment_reference or ''\"/></p>\n                    <p><strong>Statut :</strong> <t t-out=\"object.customer_label or ''\"/></p>\n                    <p t-if=\"object.origin_label or object.destination_label\"><strong>Trajet :</strong> <t t-out=\"object.origin_label or '—'\"/> → <t t-out=\"object.destination_label or '—'\"/></p>\n                    <p t-if=\"object.customer_message\"><t t-out=\"object.customer_message\"/></p>\n                    <p t-if=\"object.tracking_url\"><a t-att-href=\"object.tracking_url\">Suivre mon expédition</a></p>\n                    <p>DallyTrading</p>\n                </div>\n            "

