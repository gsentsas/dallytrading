<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        L'expédition, complétée par ses relations d'acheminement.

        ## Trois ajouts, à leur place

        Les groupes « Origin » et « Destination » existaient déjà avec le pays
        et la ville : la région et le lieu s'y ajoutent, dans l'ordre où on les
        renseigne — du plus large au plus précis. Un nouveau groupe
        « Transport » rassemble ce qui décrit le trajet lui-même.

        ## Ce qui se masque, et pourquoi

        Un navire sur une expédition aérienne n'est pas seulement inutile : sa
        présence à l'écran invite à le remplir. Les champs propres à un mode
        n'apparaissent donc que sous ce mode. Le transporteur partenaire suit la
        même règle inversée — il disparaît en aérien, où la compagnie est portée
        par son propre champ.

        Les champs de domaine sont déclarés `invisible` : le client web en a
        besoin pour filtrer les listes, l'utilisateur non.
    -->
    <record id="dally_shipment_view_form_routing" model="ir.ui.view">
        <field name="name">dally.shipment.form.routing</field>
        <field name="model">dally.shipment</field>
        <field name="inherit_id" ref="dally_freight.dally_shipment_view_form"/>
        <field name="arch" type="xml">

            <!--
                Les ancres sont des noms de champs, jamais l'intitulé d'un
                groupe : Odoo refuse `string` comme sélecteur d'héritage, et il
                a raison — un intitulé se traduit, et une vue qui s'accroche à
                un mot français casserait en anglais.
            -->
            <xpath expr="//field[@name='origin_country_id']" position="after">
                <field name="origin_state_id"
                       options="{'no_create': True}"
                       domain="[('country_id', '=?', origin_country_id)]"/>
            </xpath>

            <xpath expr="//field[@name='origin_city']" position="after">
                <field name="origin_port_id"
                       options="{'no_create': True}"
                       domain="port_domain"
                       invisible="not freight_transport"/>
            </xpath>

            <xpath expr="//field[@name='destination_country_id']" position="after">
                <field name="destination_state_id"
                       options="{'no_create': True}"
                       domain="[('country_id', '=?', destination_country_id)]"/>
            </xpath>

            <xpath expr="//field[@name='destination_city']" position="after">
                <field name="destination_port_id"
                       options="{'no_create': True}"
                       domain="port_domain"
                       invisible="not freight_transport"/>
            </xpath>

            <!-- Juste avant le notebook : le trajet se lit avec l'en-tête,
                 pas dans un onglet qu'il faut aller chercher. -->
            <xpath expr="//notebook" position="before">
                <group string="Transport">
                    <field name="freight_transport" invisible="1"/>
                    <field name="port_domain" invisible="1"/>
                    <field name="carrier_domain" invisible="1"/>
                    <field name="frequent_route_domain" invisible="1"/>

                    <field name="frequent_route_id"
                           options="{'no_create': True}"
                           domain="frequent_route_domain"
                           invisible="not freight_transport"/>
                    <field name="carrier_partner_id"
                           options="{'no_create': True}"
                           domain="carrier_domain"
                           invisible="freight_transport == 'air'"/>
                    <field name="vessel_id"
                           invisible="freight_transport != 'ocean'"/>
                    <field name="airline_id"
                           options="{'no_create': True}"
                           invisible="freight_transport != 'air'"/>
                    <field name="incoterm_id" options="{'no_create': True}"/>
                </group>
            </xpath>

        </field>
    </record>

    <!--
        Filtrer sur un port est la question qu'on pose le plus souvent après
        « quel pays » : tout ce qui part de Dakar cette semaine, tout ce qui
        arrive au Havre. Les regroupements suivent.
    -->
    <record id="dally_shipment_view_search_routing" model="ir.ui.view">
        <field name="name">dally.shipment.search.routing</field>
        <field name="model">dally.shipment</field>
        <field name="inherit_id" ref="dally_freight.dally_shipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='destination_country_id']" position="after">
                <field name="origin_port_id"/>
                <field name="destination_port_id"/>
                <field name="carrier_partner_id"/>
            </xpath>
            <xpath expr="//filter[@name='group_destination']" position="after">
                <filter name="group_origin_port" string="Port d'origine"
                        context="{'group_by': 'origin_port_id'}"/>
                <filter name="group_destination_port" string="Port de destination"
                        context="{'group_by': 'destination_port_id'}"/>
                <filter name="group_carrier" string="Transporteur"
                        context="{'group_by': 'carrier_partner_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
