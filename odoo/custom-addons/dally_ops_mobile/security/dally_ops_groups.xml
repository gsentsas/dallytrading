<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Les deux rôles de l'application terrain.

        ## Ce qu'ils accordent, et surtout ce qu'ils n'accordent pas

        Un logisticien saisit des réceptions, une caisse, des rendez-vous. Il
        n'administre rien. Aucun des deux rôles n'implique
        `group_dally_freight_sync_api` ni `group_dally_freight_billing_api` :
        ces groupes-là servent une **clé d'API**, pas une personne. Le
        connecteur tableur est un automate de confiance qui écrit en masse ;
        confondre son identité avec celle d'un téléphone reviendrait à donner à
        chaque logisticien les pouvoirs de l'automate.

        C'est aussi ce qui rend tenable la règle « aucun secret dans le
        navigateur » : l'application terrain n'a jamais besoin d'une clé
        Freight, puisque son utilisateur a ses propres droits.

        ## Pourquoi il n'implique aucun rôle métier

        Il impliquait `dally_core.group_dally_readonly`. L'audit l'a écarté :
        mesuré modèle par modèle, ce rôle ouvrait **21 modèles** en lecture,
        dont sept sans rapport avec la réception de colis — le pipeline de
        négoce (`dally.trade.opportunity`, `.line`), celui du sourcing
        (`dally.sourcing.request`, `.proposal`), les documents publiés aux
        clients, les notifications envoyées et la politique de publication.

        Un logisticien qui reçoit des colis n'a besoin d'aucun des sept. Le
        risque n'est pas théorique : ces comptes vivent sur des téléphones
        d'entrepôt, souvent partagés dans les faits.

        Le rôle n'implique donc **rien**. Chaque droit dont l'application aura
        besoin sera accordé explicitement, une ligne à la fois, et chaque ligne
        sera une décision plutôt qu'un héritage.

        ## Le responsable

        Il implique le logisticien : ce qu'il corrige, il doit d'abord pouvoir
        le voir et le saisir. Il n'implique pas `group_dally_manager` — corriger
        un poids n'exige pas d'accéder aux marges.
    -->
    <record id="group_dally_ops_logistician" model="res.groups">
        <field name="name">Ops — Logisticien</field>
        <field name="privilege_id" ref="dally_core.privilege_dallytrading"/>
        <!--
            `(6, 0, [])` et non l'absence de champ : retirer une ligne
            `(4, ref(...))` du XML **ne défait rien**. Cet ordre-là *ajoute* une
            implication ; ne plus l'écrire laisse simplement en place celle que
            la mise à jour précédente a posée. Mesuré : après avoir supprimé la
            ligne, le rôle ouvrait toujours ses 21 modèles.

            Seule une écriture autoritaire — remplacement complet — exprime
            « ce rôle n'implique rien ».
        -->
        <field name="implied_ids" eval="[(6, 0, [])]"/>
        <field name="comment">Saisie terrain : réceptions, articles, paiements
            encaissés, caisse et rendez-vous. Aucun accès à la comptabilité, aux
            tarifs de référence ni à l'administration.</field>
    </record>

    <record id="group_dally_ops_supervisor" model="res.groups">
        <field name="name">Ops — Responsable opérations</field>
        <field name="privilege_id" ref="dally_core.privilege_dallytrading"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_dally_ops_logistician')])]"/>
        <field name="comment">Corrige les saisies terrain et rouvre ce qui doit
            l'être. Ne donne accès ni aux marges, ni à la facturation
            comptabilisée, ni aux identités techniques de synchronisation.</field>
    </record>

</odoo>
