<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Les photos Ops actives deviennent consultables dans le CRM, jamais au
        portail. Une photo retirée reste conservée pour l'audit système mais
        n'est plus lisible par les utilisateurs CRM ordinaires, même avec
        active_test=False.
    -->
    <record id="rule_dally_ops_photo_crm_company" model="ir.rule">
        <field name="name">Photos Ops CRM — actives et sociétés autorisées</field>
        <field name="model_id" ref="model_dally_ops_photo"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('dally_core.group_dally_readonly'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
