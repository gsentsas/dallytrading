<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="rule_shop_operations_orders" model="ir.rule">
            <field name="name">Boutique — commandes boutique uniquement</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="groups" eval="[(4, ref('dally_shop.group_dally_shop_operations')), (4, ref('dally_core.group_dally_manager'))]"/>
            <field name="domain_force">[('dally_shop_order', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_shop_operations_order_lines" model="ir.rule">
            <field name="name">Boutique — lignes des commandes boutique uniquement</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="groups" eval="[(4, ref('dally_shop.group_dally_shop_operations')), (4, ref('dally_core.group_dally_manager'))]"/>
            <field name="domain_force">[('order_id.dally_shop_order', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_shop_operations_transitions" model="ir.rule">
            <field name="name">Boutique — historique des commandes boutique uniquement</field>
            <field name="model_id" ref="model_dally_shop_order_transition"/>
            <field name="groups" eval="[(4, ref('dally_shop.group_dally_shop_operations')), (4, ref('dally_core.group_dally_manager'))]"/>
            <field name="domain_force">[('order_id.dally_shop_order', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
