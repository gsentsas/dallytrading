<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Le groupe qui gère la vitrine, et rien d'autre.

        La personne qui administre les produits ne doit pas recevoir le rôle
        Commercial uniquement pour publier une photo ou une catégorie : ce rôle
        ouvrirait en écriture plusieurs modèles de fret et de CRM sans rapport
        avec le catalogue.

        Ce groupe accorde donc seulement les capacités boutique prévues par les
        ACL de `dally_shop`, en plus des lectures de base : galerie produit et
        catégories. Rien sur le fret, les expéditions, le portail ou le négoce.
    -->
    <record id="group_dally_shop_catalog" model="res.groups">
        <field name="name">Boutique — catalogue</field>
        <field name="privilege_id" ref="dally_core.privilege_dallytrading"/>
        <field name="implied_ids" eval="[(4, ref('dally_core.group_dally_readonly'))]"/>
        <field name="comment">Publier et illustrer le catalogue de la boutique :
            photos de galerie et catégories. N'accorde aucun droit sur le fret,
            les expéditions, le portail ni le négoce.</field>
    </record>

    <!--
        E-commerce Pro : rôle d'exploitation des commandes boutique.

        Il n'implique volontairement aucun groupe Vente. Les ACL génériques sur
        `sale.order` et `sale.order.line` restent en lecture seule et limitées aux
        commandes boutique. Les mutations passent exclusivement par les méthodes
        métier gardées : workflow commercial, cotation des frais, correction de
        l'adresse avant préparation et suivi de remise.

        Le Lot C autorise une confirmation Vente native dans un seul cas :
        `action_dally_shop_authorize_fulfillment`, après validation commerciale,
        frais connus et adresse complète. Le verrou sur `action_confirm()` empêche
        le même utilisateur de contourner ces préconditions par une autre vue ou
        un RPC. Ce rôle n'obtient toujours aucun droit générique sur les ventes
        ordinaires, les factures ou les paiements.
    -->
    <record id="group_dally_shop_operations" model="res.groups">
        <field name="name">Boutique — opérations</field>
        <field name="privilege_id" ref="dally_core.privilege_dallytrading"/>
        <field name="implied_ids" eval="[(4, ref('dally_core.group_dally_readonly'))]"/>
        <field name="comment">Exploiter uniquement les commandes boutique via les
            actions métier gardées : validation commerciale, frais, adresse,
            autorisation de préparation et suivi de remise. Aucun droit générique
            d'écriture sur les ventes, aucune facture, aucun paiement et aucun
            accès aux ventes ordinaires.</field>
    </record>

</odoo>
