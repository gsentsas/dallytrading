<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dally_shop_category_view_list" model="ir.ui.view">
        <field name="name">dally.shop.category.list</field>
        <field name="model">dally.shop.category</field>
        <field name="arch" type="xml">
            <list string="Catégories boutique">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="parent_id"/>
                <field name="published" widget="boolean_toggle"/>
                <field name="product_count" string="Produits publiés"/>
            </list>
        </field>
    </record>

    <record id="dally_shop_category_view_form" model="ir.ui.view">
        <field name="name">dally.shop.category.form</field>
        <field name="model">dally.shop.category</field>
        <field name="arch" type="xml">
            <form string="Catégorie boutique">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom public"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="slug" placeholder="pieces-detachees"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="published"/>
                            <field name="product_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dally_shop_category_action" model="ir.actions.act_window">
        <field name="name">Catégories boutique</field>
        <field name="res_model">dally.shop.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer une catégorie boutique</p>
            <p>La taxonomie publique est distincte des catégories comptables :
               renommer une vitrine ne doit pas déplacer des écritures.</p>
        </field>
    </record>

</odoo>
