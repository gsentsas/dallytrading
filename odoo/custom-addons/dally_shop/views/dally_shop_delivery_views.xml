<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dally_shop_delivery_method_list" model="ir.ui.view">
        <field name="name">dally.shop.delivery.method.list</field>
        <field name="model">dally.shop.delivery.method</field>
        <field name="arch" type="xml">
            <list string="Méthodes de remise" default_order="sequence,id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="kind"/>
                <field name="fee_policy"/>
                <field name="fixed_fee" optional="show"/>
                <field name="currency_id" optional="hide"/>
                <field name="requires_address" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_dally_shop_delivery_method_form" model="ir.ui.view">
        <field name="name">dally.shop.delivery.method.form</field>
        <field name="model">dally.shop.delivery.method</field>
        <field name="arch" type="xml">
            <form string="Méthode de remise">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ex. Livraison Dakar"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="kind"/>
                            <field name="requires_address" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="fee_policy"/>
                            <field name="fixed_fee" invisible="fee_policy != 'fixed'"/>
                            <field name="currency_id" invisible="fee_policy == 'quote'"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group>
                        <field name="client_help" placeholder="Message court affiché au client"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dally_shop_delivery_methods" model="ir.actions.act_window">
        <field name="name">Méthodes de remise</field>
        <field name="res_model">dally.shop.delivery.method</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configurez les options proposées au checkout.</p>
            <p>Le navigateur n'envoie jamais de montant : les frais sont décidés dans Odoo.</p>
        </field>
    </record>

</odoo>
