<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dally_shop_shipping_address_wizard" model="ir.ui.view">
        <field name="name">dally.shop.shipping.address.wizard.form</field>
        <field name="model">dally.shop.shipping.address.wizard</field>
        <field name="arch" type="xml">
            <form string="Adresse de livraison">
                <group>
                    <field name="order_id" readonly="1"/>
                </group>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="street"/>
                        <field name="street2"/>
                    </group>
                    <group>
                        <field name="city"/>
                        <field name="zip"/>
                        <field name="country_code"
                               placeholder="SN"/>
                    </group>
                </group>
                <div class="alert alert-info" role="status">
                    Cette adresse est figée sur la commande. Elle ne modifie pas
                    le profil du client et ne peut plus être changée après
                    autorisation de la préparation.
                </div>
                <footer>
                    <button name="action_apply"
                            string="Enregistrer l'adresse"
                            type="object"
                            class="btn-primary"/>
                    <button string="Fermer"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_dally_shop_order_form_shipping_management" model="ir.ui.view">
        <field name="name">sale.order.form.dally.shop.shipping.management</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="dally_shop.view_dally_shop_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_dally_shop_open_delivery_fee']" position="after">
                <button name="action_dally_shop_open_shipping_address"
                        string="Modifier l'adresse"
                        type="object"
                        groups="dally_shop.group_dally_shop_operations,dally_core.group_dally_manager"
                        invisible="not dally_shop_delivery_requires_address or dally_shop_fulfillment_authorized or dally_shop_workflow_state not in ['received', 'validated']"/>
            </xpath>
            <xpath expr="//field[@name='dally_shop_shipping_country_code']" position="after">
                <field name="dally_shop_shipping_updated_at"
                       readonly="1"
                       invisible="not dally_shop_shipping_updated_at"/>
                <field name="dally_shop_shipping_updated_by_id"
                       readonly="1"
                       invisible="not dally_shop_shipping_updated_at"/>
            </xpath>
        </field>
    </record>

</odoo>
