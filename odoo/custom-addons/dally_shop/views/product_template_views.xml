<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Extension du formulaire produit.

        Un seul point d'ancrage : le <notebook> du formulaire natif, stable de
        version en version. Multiplier les xpath fragiles est la raison
        habituelle pour laquelle un module maison casse à la montée de version.
    -->
    <record id="product_template_view_form_dally_shop" model="ir.ui.view">
        <field name="name">product.template.form.dally.shop</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Boutique" name="dally_shop">
                    <group>
                        <group string="Publication">
                            <field name="dally_published"/>
                            <field name="dally_shop_slug"
                                   placeholder="groupe-electrogene-5kva"
                                   help="Adresse publique du produit. L'identifiant
                                         de base ne franchit jamais la frontière :
                                         un entier séquentiel s'énumère."/>
                            <field name="dally_shop_category_id"/>
                            <field name="dally_shop_sequence"/>
                        </group>
                        <group string="Disponibilité">
                            <field name="dally_stock_policy"/>
                        </group>
                    </group>
                    <group string="Texte de vitrine">
                        <field name="dally_shop_summary" nolabel="1"
                               placeholder="Une ou deux phrases affichées sur la vitrine."/>
                    </group>

                    <!--
                        Galerie.

                        ## Le bouton d'ajout est explicite, et il a fallu qu'il le soit

                        Symptôme constaté en production : la zone galerie
                        s'affichait vide, sans aucun moyen d'ajouter une photo.
                        La cause n'était pas ici — l'utilisateur n'avait pas le
                        droit de créer, et le client web masque alors le contrôle,
                        ce qui est le comportement correct. Mais la version
                        précédente s'en remettait à la vignette fantôme que le
                        kanban ajoute en fin de liste : discrète, sans libellé, et
                        indiscernable d'une zone vide.

                        `<control><create/></control>` donne un bouton nommé.
                        L'analyseur de vue kanban d'Odoo 19 le reconnaît et en
                        reprend le `string` — vérifié dans
                        `web/static/src/views/kanban/kanban_arch_parser.js`.

                        ## Aucun `default_product_tmpl_id`

                        Le champ inverse d'un one2many est renseigné par l'ORM à
                        l'enregistrement du parent : mesuré, `product_tmpl_id`
                        vaut bien le produit courant sans qu'aucun contexte ne le
                        demande. Le passer en contexte laissait croire que la
                        liaison en dépendait — et la valeur `id` y est fausse pour
                        un produit pas encore enregistré.

                        Hors d'un `<group>` : une galerie occupe la largeur, et un
                        groupe la comprime dans une colonne de formulaire.

                        Vue kanban et non liste : on choisit une photo en la
                        regardant. `handle` sur la séquence donne le
                        glisser-déposer. Aucun `sudo` ici : les droits viennent des
                        ACL, et c'est bien ce qui a masqué le bouton.
                    -->
                    <separator string="Galerie produit"/>
                    <p class="text-muted">
                        Photos supplémentaires affichées sur la fiche publique,
                        après la photo principale du produit.
                    </p>
                    <field name="dally_shop_image_ids" nolabel="1" mode="kanban">
                        <kanban default_order="sequence">
                            <field name="sequence" widget="handle"/>
                            <control>
                                <create string="Ajouter des photos"/>
                            </control>
                            <templates>
                                <t t-name="card">
                                    <div class="row">
                                        <div class="col-4">
                                            <field name="image_1920"
                                                   widget="image"
                                                   options="{'size': [90, 90]}"/>
                                        </div>
                                        <div class="col-8">
                                            <field name="name" class="fw-bold"/>
                                            <div class="text-muted">
                                                Ordre <field name="sequence"/>
                                            </div>
                                            <field name="active"
                                                   widget="boolean_toggle"/>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                        <form string="Photo de galerie">
                            <sheet>
                                <!--
                                    L'image d'abord et en grand : c'est ce qu'on
                                    vient déposer. Le reste tient en deux champs.
                                    Le produit parent n'apparaît pas — il est
                                    déduit, et l'afficher inviterait à le changer.
                                -->
                                <field name="image_1920" widget="image"
                                       class="oe_avatar"
                                       options="{'size': [400, 400]}"/>
                                <group>
                                    <field name="name"
                                           placeholder="Vue arrière, intérieur de caisse…"/>
                                    <field name="sequence"/>
                                    <field name="active"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <!--
        Filtres de recherche.

        « Publiés » est le filtre que le propriétaire utilisera le plus : il
        répond à la seule question qui compte avant une mise en ligne — qu'est-ce
        qui est visible du public en ce moment.
    -->
    <record id="product_template_view_search_dally_shop" model="ir.ui.view">
        <field name="name">product.template.search.dally.shop</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="dally_published" string="Publiés sur la boutique"
                        domain="[('dally_published', '=', True)]"/>
                <filter name="dally_not_published" string="Non publiés"
                        domain="[('dally_published', '=', False)]"/>
                <group>
                    <filter name="group_dally_shop_category"
                            string="Catégorie boutique"
                            context="{'group_by': 'dally_shop_category_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!--
        Action dédiée : la liste des produits publiables, sans avoir à composer
        un filtre à chaque fois.
    -->
    <record id="dally_shop_product_action" model="ir.actions.act_window">
        <field name="name">Produits boutique</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_dally_published': 1}</field>
    </record>

</odoo>
