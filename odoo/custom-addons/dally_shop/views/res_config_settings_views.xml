<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_dally_shop" model="ir.ui.view">
        <field name="name">res.config.settings.form.dally.shop</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Boutique DallyTrading" name="dally_shop"
                     logo="/base/static/img/icons/settings.png">
                    <block title="Tarification publique"
                           help="Sans tarif choisi, la boutique n'affiche aucun prix.">
                        <setting id="dally_shop_pricelist"
                                 string="Tarif de la boutique"
                                 help="Le prix de liste d'un produit n'a pas été
                                       décidé pour la vente publique : la boutique
                                       refuse d'y retomber.">
                            <field name="dally_shop_pricelist_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
