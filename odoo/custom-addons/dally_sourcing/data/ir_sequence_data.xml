<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        noupdate="1": resetting number_next on an upgrade would re-issue references
        that customers already hold and quote back.
    -->
    <data noupdate="1">

        <!--
            Sourcing request: DT-SRC-2026-000001.

            implementation="standard" rather than "no_gap": no_gap locks the sequence
            row for the whole transaction, serialising concurrent submissions. A gap
            in the series is harmless; contention on the public form is not.
        -->
        <record id="seq_dally_sourcing_request" model="ir.sequence">
            <field name="name">DallyTrading Sourcing Request</field>
            <field name="code">dally.sourcing.request</field>
            <field name="prefix">DT-SRC-%(year)s-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

        <!--
            Customer proposal: DT-SRP-2026-000001. Its own series, because a proposal
            is a document the customer quotes back, distinct from the request.
        -->
        <record id="seq_dally_sourcing_proposal" model="ir.sequence">
            <field name="name">DallyTrading Sourcing Proposal</field>
            <field name="code">dally.sourcing.proposal</field>
            <field name="prefix">DT-SRP-%(year)s-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
