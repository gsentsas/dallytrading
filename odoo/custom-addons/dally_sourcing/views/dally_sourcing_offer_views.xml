<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sourcing_offer_view_list" model="ir.ui.view">
        <field name="name">dally.sourcing.offer.list</field>
        <field name="model">dally.sourcing.offer</field>
        <field name="arch" type="xml">
            <list string="Supplier Offers"
                  decoration-success="selected"
                  decoration-muted="is_expired">
                <field name="request_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="reference" optional="hide"/>
                <field name="received_date"/>
                <field name="currency_id"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="subtotal" optional="hide"/>
                <field name="shipping_cost" optional="hide"/>
                <field name="total_landed_cost"/>
                <field name="landed_unit_cost"/>
                <field name="lead_time_days"/>
                <field name="incoterm_id" optional="show"/>
                <field name="validity_date"/>
                <field name="overall_score"/>
                <field name="selected" widget="boolean_toggle"/>
                <field name="is_expired" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="sourcing_offer_view_form" model="ir.ui.view">
        <field name="name">dally.sourcing.offer.form</field>
        <field name="model">dally.sourcing.offer</field>
        <field name="arch" type="xml">
            <form string="Supplier Offer">
                <header>
                    <button name="action_select" type="object"
                            string="Select This Offer" class="btn-primary"
                            invisible="selected"
                            groups="dally_sourcing.group_dally_sourcing_manager"/>
                    <button name="action_deselect" type="object" string="Deselect"
                            class="btn-secondary" invisible="not selected"
                            groups="dally_sourcing.group_dally_sourcing_manager"/>
                    <button name="action_create_proposal" type="object"
                            string="Draft Customer Proposal" class="btn-primary"
                            groups="dally_sourcing.group_dally_sourcing_manager"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Selected"
                            bg_color="text-bg-success" invisible="not selected"/>

                    <div class="alert alert-danger" role="alert">
                        <strong>Internal document.</strong> Everything on this form is
                        what a supplier quoted DallyTrading. It is never exposed to the
                        customer and appears in no public payload. The customer receives
                        a <strong>proposal</strong>, composed from these figures.
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="not is_expired">
                        This offer has expired. Ask the supplier to reconfirm before
                        selecting it.
                    </div>

                    <group>
                        <group string="Origin">
                            <field name="request_id"
                                   options="{'no_create': True}"/>
                            <field name="supplier_id"
                                   options="{'no_create': True}"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="reference"/>
                            <field name="received_date"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Quantity">
                            <field name="currency_id"
                                   options="{'no_create': True}"/>
                            <field name="quantity"/>
                            <field name="uom_id" options="{'no_create': True}"/>
                            <field name="minimum_order_quantity"/>
                        </group>
                    </group>

                    <group>
                        <group string="Costs">
                            <field name="unit_price"/>
                            <field name="subtotal" readonly="1"/>
                            <field name="shipping_cost"/>
                            <field name="insurance_cost"/>
                            <field name="customs_estimate"/>
                            <field name="other_costs"/>
                        </group>
                        <group string="Landed cost">
                            <field name="total_landed_cost" readonly="1"/>
                            <field name="landed_unit_cost" readonly="1"/>
                            <div class="text-muted" colspan="2">
                                The landed unit cost is the only figure that compares two
                                offers meaningfully — a low unit price with high freight
                                is not a cheap offer.
                            </div>
                        </group>
                    </group>

                    <group>
                        <group string="Terms">
                            <field name="incoterm_id"
                                   options="{'no_create': True}"/>
                            <field name="lead_time_days"/>
                            <field name="validity_date"/>
                            <field name="is_expired" invisible="1"/>
                            <field name="selected" invisible="1"/>
                        </group>
                        <group string="Sample">
                            <field name="sample_available"/>
                            <field name="sample_cost"
                                   invisible="not sample_available"/>
                        </group>
                    </group>

                    <group string="Assessment">
                        <div class="text-muted" colspan="2">
                            A guide for the comparison, not a verdict. The cheapest offer
                            from an unverified factory with a 90-day lead time is not the
                            best one — the decision stays human.
                        </div>
                        <group>
                            <field name="quality_score"/>
                            <field name="price_score"/>
                        </group>
                        <group>
                            <field name="lead_time_score"/>
                            <field name="reliability_score"/>
                            <field name="overall_score" readonly="1"/>
                        </group>
                    </group>

                    <group string="Internal Notes">
                        <field name="internal_notes" nolabel="1"
                               placeholder="Negotiation context, doubts, anything learned about the supplier."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sourcing_offer_view_search" model="ir.ui.view">
        <field name="name">dally.sourcing.offer.search</field>
        <field name="model">dally.sourcing.offer</field>
        <field name="arch" type="xml">
            <search string="Supplier Offers">
                <field name="request_id"/>
                <field name="partner_id"/>
                <field name="reference"/>
                <filter name="filter_selected" string="Selected"
                        domain="[('selected', '=', True)]"/>
                <filter name="filter_valid" string="Still Valid"
                        domain="[('is_expired', '=', False)]"/>
                <filter name="filter_expired" string="Expired"
                        domain="[('is_expired', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_request" string="Request"
                            context="{'group_by': 'request_id'}"/>
                    <filter name="group_supplier" string="Supplier"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_currency" string="Currency"
                            context="{'group_by': 'currency_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sourcing_offer_action" model="ir.actions.act_window">
        <field name="name">Supplier Offers</field>
        <field name="res_model">dally.sourcing.offer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sourcing_offer_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No supplier offer yet</p>
            <p>
                Offers are internal. They are never shown to a customer — a proposal is.
            </p>
        </field>
    </record>

</odoo>
