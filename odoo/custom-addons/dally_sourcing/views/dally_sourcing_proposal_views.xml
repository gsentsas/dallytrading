<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sourcing_proposal_view_list" model="ir.ui.view">
        <field name="name">dally.sourcing.proposal.list</field>
        <field name="model">dally.sourcing.proposal</field>
        <field name="arch" type="xml">
            <list string="Customer Proposals" sample="1"
                  decoration-success="state == 'accepted'"
                  decoration-muted="state in ('rejected', 'cancelled', 'expired')">
                <field name="reference"/>
                <field name="request_id" optional="show"/>
                <field name="customer_id"/>
                <field name="product_name"/>
                <field name="quantity"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="selling_unit_price"/>
                <field name="total_amount" sum="Total proposed"/>
                <field name="margin" optional="hide"
                       groups="dally_sourcing.group_dally_sourcing_manager"/>
                <field name="validity_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'accepted'"
                       decoration-info="state == 'sent'"
                       decoration-danger="state in ('rejected', 'expired')"/>
            </list>
        </field>
    </record>

    <record id="sourcing_proposal_view_form" model="ir.ui.view">
        <field name="name">dally.sourcing.proposal.form</field>
        <field name="model">dally.sourcing.proposal</field>
        <field name="arch" type="xml">
            <form string="Customer Proposal">
                <header>
                    <button name="action_validate_price" type="object"
                            string="Validate Price" class="btn-primary"
                            groups="dally_sourcing.group_dally_sourcing_manager,dally_core.group_dally_finance"
                            invisible="price_validated or state not in ('draft', 'ready')"/>
                    <button name="action_revoke_price_validation" type="object"
                            string="Withdraw Price Validation" class="btn-secondary"
                            groups="dally_sourcing.group_dally_sourcing_manager,dally_core.group_dally_finance"
                            invisible="not price_validated or state not in ('draft', 'ready')"/>
                    <button name="action_mark_ready" type="object"
                            string="Mark Ready" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_send" type="object"
                            string="Mark as Sent" class="btn-primary"
                            invisible="state != 'ready'"/>
                    <button name="action_accept" type="object" string="Accepted"
                            class="btn-primary" invisible="state != 'sent'"/>
                    <button name="action_reject" type="object" string="Rejected"
                            class="btn-secondary" invisible="state != 'sent'"/>
                    <button name="action_mark_expired" type="object"
                            string="Expired" class="btn-secondary"
                            invisible="state != 'sent'"/>
                    <button name="action_back_to_draft" type="object"
                            string="Back to Draft" class="btn-secondary"
                            invisible="state not in ('ready', 'rejected', 'expired')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-secondary"
                            confirm="Cancel this proposal?"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ready,sent,accepted"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>

                    <div class="oe_title">
                        <label for="reference"/>
                        <h1><field name="reference" readonly="1"/></h1>
                        <h2><field name="product_name"/></h2>
                    </div>

                    <div class="alert alert-info" role="alert">
                        This is what the <strong>customer</strong> sees. It is composed,
                        not copied: no supplier name, no purchase price and no cost line
                        appears here.
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="not is_expired">
                        This proposal has passed its validity date. Reconfirm prices
                        before relying on it.
                    </div>

                    <group>
                        <group string="Context">
                            <field name="request_id"
                                   options="{'no_create': True}"/>
                            <field name="customer_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="active" invisible="1"/>
                            <field name="is_expired" invisible="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Quantity">
                            <field name="currency_id"
                                   options="{'no_create': True}"/>
                            <field name="quantity"/>
                            <field name="uom_id" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <group>
                        <group string="Customer price">
                            <field name="selling_unit_price"/>
                            <field name="subtotal" readonly="1"/>
                            <field name="estimated_shipping"/>
                            <field name="service_fee"/>
                            <field name="other_customer_charges"/>
                            <field name="tax_amount"/>
                            <field name="total_amount" readonly="1"
                                   class="oe_subtotal_footer_separator"/>
                            <!-- Visible to everyone who can see the proposal: a
                                 sourcing user needs to know why it will not send.
                                 Only the buttons above are group-restricted. -->
                            <field name="price_validated" readonly="1"/>
                            <field name="price_validated_by_id" readonly="1"
                                   invisible="not price_validated"/>
                            <field name="price_validated_on" readonly="1"
                                   invisible="not price_validated"/>
                        </group>
                        <group string="Dates">
                            <field name="estimated_delivery"/>
                            <field name="validity_date"/>
                            <field name="sent_date" readonly="1"
                                   invisible="not sent_date"/>
                            <field name="decision_date" readonly="1"
                                   invisible="not decision_date"/>
                            <field name="sale_order_id" readonly="1"
                                   invisible="not sale_order_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description and Terms" name="terms">
                            <group string="Description">
                                <field name="product_description" nolabel="1"/>
                            </group>
                            <group string="Commercial Terms">
                                <div class="text-muted" colspan="2">
                                    Shown to the customer verbatim: payment terms,
                                    delivery conditions, what is and is not included.
                                </div>
                                <field name="commercial_terms" nolabel="1" colspan="2"/>
                            </group>
                        </page>

                        <page string="Margin" name="margin"
                              groups="dally_sourcing.group_dally_sourcing_manager,dally_core.group_dally_finance">
                            <div class="alert alert-danger" role="alert">
                                <strong>Restricted.</strong> These figures are removed by
                                the ORM for anyone outside sourcing management and
                                finance, and appear in no public payload. A commercial
                                user can present this proposal without seeing them.
                            </div>
                            <group>
                                <group>
                                    <field name="source_offer_id" readonly="1"
                                           groups="dally_core.group_dally_sourcing"/>
                                    <field name="cost_basis"/>
                                </group>
                                <group>
                                    <field name="margin" readonly="1"/>
                                    <field name="margin_rate" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Internal Notes" name="internal">
                            <field name="internal_notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sourcing_proposal_view_search" model="ir.ui.view">
        <field name="name">dally.sourcing.proposal.search</field>
        <field name="model">dally.sourcing.proposal</field>
        <field name="arch" type="xml">
            <search string="Customer Proposals">
                <field name="reference"/>
                <field name="request_id"/>
                <field name="customer_id"/>
                <field name="product_name"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_sent" string="Sent"
                        domain="[('state', '=', 'sent')]"/>
                <filter name="filter_accepted" string="Accepted"
                        domain="[('state', '=', 'accepted')]"/>
                <filter name="filter_open" string="Open"
                        domain="[('state', 'in', ('draft', 'ready', 'sent'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_customer" string="Customer"
                            context="{'group_by': 'customer_id'}"/>
                    <filter name="group_created" string="Created"
                            context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sourcing_proposal_view_pivot" model="ir.ui.view">
        <field name="name">dally.sourcing.proposal.pivot</field>
        <field name="model">dally.sourcing.proposal</field>
        <field name="arch" type="xml">
            <pivot string="Proposal Analysis" sample="1">
                <field name="state" type="col"/>
                <field name="customer_id" type="row"/>
                <field name="total_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sourcing_proposal_action" model="ir.actions.act_window">
        <field name="name">Customer Proposals</field>
        <field name="res_model">dally.sourcing.proposal</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="sourcing_proposal_view_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No proposal yet</p>
            <p>
                A proposal is drafted from a selected supplier offer, then priced and
                worded before being sent.
            </p>
        </field>
    </record>

</odoo>
