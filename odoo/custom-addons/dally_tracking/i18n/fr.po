#. module: dally_tracking
#: model_terms:ir.ui.view,arch_db:dally_tracking.dally_shipment_event_view_form
msgid ""
"<strong>Internal only.</strong> This event does not appear on\n"
"                        the public tracking page."
msgstr ""
"<strong>Interne uniquement.</strong> Cet événement n’apparaît pas sur\n"
"                        la page publique de suivi."

#. module: dally_tracking
#: model_terms:ir.ui.view,arch_db:dally_tracking.dally_shipment_event_view_form
msgid ""
"<strong>Published.</strong> The description and the location\n"
"                        above appear on the public tracking page, exactly as written.\n"
"                        Attached documents are never published."
msgstr ""
"<strong>Publié.</strong> La désignation et le lieu\n"
"                        ci-dessus apparaissent tels quels sur la page publique de suivi.\n"
"                        Les documents joints ne sont jamais publiés."

#. module: dally_tracking
#. odoo-python
#: code:addons/dally_tracking/models/dally_shipment_event.py:0
msgid ""
"A customer-visible event needs a meaningful description. It is published "
"exactly as written."
msgstr "Un événement visible par le client doit avoir une désignation explicite. Il est publié tel quel."

#. module: dally_tracking
#. odoo-python
#: code:addons/dally_tracking/controllers/tracking.py:0
msgid ""
"A reference and a tracking code are required: /api/v1/tracking/DT-SHP-YYYY-"
"NNNNNN?token=..."
msgstr "Une référence et un code de suivi sont requis : /api/v1/tracking/DT-SHP-YYYY-NNNNNN?token=..."

#. module: dally_tracking
#: model:ir.model.constraint,message:dally_tracking.constraint_dally_shipment_event_dally_event_description_not_empty
