<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Two groups, and a third identity that is not a human.

            group_dally_trade_user  — works deals: parties, lines, sale side, workflow.
            group_dally_trade_manager — additionally sees purchase prices, costs,
                                        commissions, margins, and approves.

            The split is not cosmetic. Every internal commercial field in this module
            carries groups="dally_trade.group_dally_trade_manager,
            dally_core.group_dally_finance", which means the ORM does not load them
            for a trade user at all. Being absent from a form is not protection;
            being absent from the query is.
        -->

        <record id="group_dally_trade_user" model="res.groups">
            <field name="name">DallyTrading / Trade — Utilisateur</field>
            <field name="privilege_id" ref="dally_core.privilege_dallytrading"/>
            <field name="implied_ids" eval="[(4, ref('dally_core.group_dally_commercial'))]"/>
            <field name="comment">Travaille les opérations de trading : parties, lignes,
volet vente, workflow. Ne voit ni prix d'achat, ni coûts, ni marges.</field>
        </record>

        <record id="group_dally_trade_manager" model="res.groups">
            <field name="name">DallyTrading / Trade — Responsable</field>
            <field name="privilege_id" ref="dally_core.privilege_dallytrading"/>
            <field name="implied_ids" eval="[(4, ref('dally_trade.group_dally_trade_user'))]"/>
            <field name="comment">Voit et modifie le volet achat, les coûts, les
commissions et les marges. Seul habilité, avec la direction générale, à approuver une
opération sensible.</field>
        </record>

        <!--
            The API group and its user.

            A fourth integration identity, and the reason is the same as ADR-011: the
            leads user carries group_dally_commercial, which implies
            group_dally_readonly — precisely the group that gates internal_notes.
            Reusing it here would make internal notes loadable by the ORM on the
            public path, leaving the controller's allowlist as the only protection.
        -->
        <record id="group_dally_trade_api" model="res.groups">
            <field name="name">DallyTrading / Trade — API</field>
            <field name="privilege_id" ref="dally_core.privilege_dallytrading_technical"/>
            <field name="comment">Groupe technique de l'utilisateur d'intégration
trading. N'implique aucun autre groupe : il ne doit pouvoir que créer une demande
publique et relire les siennes.</field>
        </record>

        <record id="user_dally_api_trade" model="res.users">
            <field name="name">DallyTrading API — Trading</field>
            <field name="login">api.trade@dallytrading.local</field>
            <field name="active" eval="True"/>
            <field name="share" eval="False"/>
            <!--
                Deliberately NOT in group_dally_commercial or group_dally_readonly:
                either would make internal_notes and other restricted fields loadable.
                Least privilege here is not a slogan, it is the mechanism.
            -->
            <field name="group_ids" eval="[(6, 0, [
                ref('base.group_user'),
                ref('dally_trade.group_dally_trade_api'),
            ])]"/>
        </record>

    </data>
</odoo>
